# Read by ../run.sh. Session A2: a GPU with a wider power range than the T4,
# 3 repeats, continuous sampling, rule-B validation, probe prototype.
# Default L4; override when a type is out of capacity, e.g.
#   INSTANCE_TYPE=g5.xlarge ./experiments/real-gpu/run.sh session-a2
INSTANCE_TYPE=${INSTANCE_TYPE:-g6.xlarge}
case $INSTANCE_TYPE in   # on-demand us-east-1, checked 2026-09-30
  g6.xlarge)   PRICE_PER_HOUR=0.805 ;;  # 1x L4
  g5.xlarge)   PRICE_PER_HOUR=1.006 ;;  # 1x A10G
  g4dn.xlarge) PRICE_PER_HOUR=0.526 ;;  # 1x T4
  *) echo "unknown INSTANCE_TYPE $INSTANCE_TYPE (add its price to session.env)" >&2; exit 1 ;;
esac
AMI_NAME_PATTERN="Deep Learning OSS Nvidia Driver AMI GPU PyTorch 2.12 (Ubuntu 24.04) *"
EXPECTED_MINUTES="45-55"
