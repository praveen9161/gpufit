# Read by ../run.sh. Session C: validate GPUFit v0.1 (Helm chart, observe -> enforce + rescue)
# on 4 VMs; measure straggler vs rescue. Driven from the Mac by orchestrate.sh.
INSTANCE_COUNT=4
INSTANCE_TYPE=${INSTANCE_TYPE:-g5.xlarge}   # A10G; us-east-1c had capacity on 2026-10-01
case $INSTANCE_TYPE in   # on-demand us-east-1, per VM, checked 2026-09-30
  g5.xlarge)   PRICE_PER_HOUR=1.006 ;;
  g6.xlarge)   PRICE_PER_HOUR=0.805 ;;
  g4dn.xlarge) PRICE_PER_HOUR=0.526 ;;
  *) echo "unknown INSTANCE_TYPE $INSTANCE_TYPE" >&2; exit 1 ;;
esac
AMI_NAME_PATTERN="Deep Learning OSS Nvidia Driver AMI GPU PyTorch 2.12 (Ubuntu 24.04) *"
EXPECTED_MINUTES="70-90"
