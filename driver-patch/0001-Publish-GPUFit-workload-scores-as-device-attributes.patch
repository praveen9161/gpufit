+package main
+
+import (
+	"testing"
+
+	resourceapi "k8s.io/api/resource/v1"
+	"k8s.io/dynamic-resource-allocation/resourceslice"
+	"k8s.io/utils/ptr"
+)
+
+func TestWithGPUFitScores(t *testing.T) {
+	base := resourceslice.DriverResources{
+		Pools: map[string]resourceslice.Pool{
+			"node": {Slices: []resourceslice.Slice{{Devices: []resourceapi.Device{
+				{Name: "gpu-0", Attributes: map[resourceapi.QualifiedName]resourceapi.DeviceAttribute{
+					"model": {StringValue: ptr.To("LATEST-GPU-MODEL")},
+				}},
+				{Name: "gpu-1"},
+			}}}},
+		},
+	}
+	scores, err := parseGPUFitScores(`{"gpu-0": {"training": 0, "inference": 100}}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	got := withGPUFitScores(base, scores)
+
+	devices := got.Pools["node"].Slices[0].Devices
+	attrs := devices[0].Attributes
+	if v := attrs["gpufit.io/trainingScore"].IntValue; v == nil || *v != 0 {
+		t.Errorf("gpu-0 trainingScore = %v, want 0", v)
+	}
+	if v := attrs["gpufit.io/inferenceScore"].IntValue; v == nil || *v != 100 {
+		t.Errorf("gpu-0 inferenceScore = %v, want 100", v)
+	}
+	if attrs["model"].StringValue == nil {
+		t.Error("gpu-0 lost its existing model attribute")
+	}
+	if len(devices[1].Attributes) != 0 {
+		t.Errorf("gpu-1 has no scores but got attributes %v", devices[1].Attributes)
+	}
+
+	// The driver's own copy must stay untouched so deleting the ConfigMap can
+	// republish the original devices.
+	if len(base.Pools["node"].Slices[0].Devices[0].Attributes) != 1 {
+		t.Errorf("base was modified: %v", base.Pools["node"].Slices[0].Devices[0].Attributes)
+	}
+}
+
+func TestParseGPUFitScoresRejectsBadInput(t *testing.T) {
+	for _, raw := range []string{
+		`not json`,
+		`{"gpu-0": {"training": 101}}`,
+		`{"gpu-0": {"training": -1}}`,
+		`{"gpu-0": {"Training": 50}}`,
+		`{"gpu-0": {"train-ing": 50}}`,
+	} {
+		if _, err := parseGPUFitScores(raw); err == nil {
+			t.Errorf("parseGPUFitScores(%q) = nil error, want error", raw)
+		}
+	}
+}
