+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package main
+
+// GPUFit: publish per-GPU workload fitness scores as DRA device attributes.
+//
+// Scores live in a ConfigMap in the driver's namespace, written by gpufit-agent:
+//
+//	data:
+//	  scores.json: {"gpu-0": {"training": 100, "finetune": 100, "inference": 100}, ...}
+//
+// The driver polls it and, whenever it changes, republishes its ResourceSlices
+// with one attribute per workload: gpufit.io/trainingScore, gpufit.io/finetuneScore,
+// gpufit.io/inferenceScore. Claims then select on them with CEL, e.g.
+//
+//	device.attributes["gpufit.io"].trainingScore >= 80
+//
+// Deleting the ConfigMap republishes the devices without scores.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"regexp"
+	"time"
+
+	resourceapi "k8s.io/api/resource/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/dynamic-resource-allocation/resourceslice"
+	"k8s.io/klog/v2"
+	"k8s.io/utils/ptr"
+)
+
+const (
+	gpufitDomain       = "gpufit.io"
+	gpufitScoresKey    = "scores.json"
+	gpufitPollInterval = 5 * time.Second
+)
+
+// Workload names become part of an attribute name ("<workload>Score"), which
+// must be a C identifier of at most 32 characters.
+var gpufitWorkloadName = regexp.MustCompile(`^[a-z][a-zA-Z0-9]{0,26}$`)
+
+// gpufitScores maps device name -> workload -> score (0-100).
+type gpufitScores map[string]map[string]int64
+
+func parseGPUFitScores(raw string) (gpufitScores, error) {
+	var scores gpufitScores
+	if err := json.Unmarshal([]byte(raw), &scores); err != nil {
+		return nil, fmt.Errorf("parse %s: %w", gpufitScoresKey, err)
+	}
+	for device, byWorkload := range scores {
+		for workload, score := range byWorkload {
+			if !gpufitWorkloadName.MatchString(workload) {
+				return nil, fmt.Errorf("device %s: invalid workload name %q", device, workload)
+			}
+			if score < 0 || score > 100 {
+				return nil, fmt.Errorf("device %s: %s score %d not in [0, 100]", device, workload, score)
+			}
+		}
+	}
+	return scores, nil
+}
+
+// withGPUFitScores returns a copy of base with score attributes added to every
+// device that has an entry in scores. base is not modified.
+func withGPUFitScores(base resourceslice.DriverResources, scores gpufitScores) resourceslice.DriverResources {
+	out := resourceslice.DriverResources{Pools: make(map[string]resourceslice.Pool, len(base.Pools))}
+	for poolName, pool := range base.Pools {
+		slices := make([]resourceslice.Slice, len(pool.Slices))
+		for i, slice := range pool.Slices {
+			devices := make([]resourceapi.Device, len(slice.Devices))
+			for j := range slice.Devices {
+				device := *slice.Devices[j].DeepCopy()
+				for workload, score := range scores[device.Name] {
+					if device.Attributes == nil {
+						device.Attributes = map[resourceapi.QualifiedName]resourceapi.DeviceAttribute{}
+					}
+					name := resourceapi.QualifiedName(gpufitDomain + "/" + workload + "Score")
+					device.Attributes[name] = resourceapi.DeviceAttribute{IntValue: ptr.To(score)}
+				}
+				devices[j] = device
+			}
+			slice.Devices = devices
+			slices[i] = slice
+		}
+		pool.Slices = slices
+		out.Pools[poolName] = pool
+	}
+	return out
+}
+
+// gpufitScoresLoop polls the scores ConfigMap and republishes the driver's
+// ResourceSlices whenever its content changes. It runs until ctx is done.
+func (d *driver) gpufitScoresLoop(ctx context.Context, namespace, configMap string) {
+	logger := klog.FromContext(ctx).WithName("gpufit").WithValues("configMap", namespace+"/"+configMap)
+	logger.Info("Watching GPUFit scores", "interval", gpufitPollInterval)
+
+	ticker := time.NewTicker(gpufitPollInterval)
+	defer ticker.Stop()
+
+	// "" means "no scores", which is what the driver published at startup.
+	published := ""
+	for {
+		raw, err := d.readGPUFitScores(ctx, namespace, configMap)
+		if err != nil {
+			logger.Error(err, "Reading GPUFit scores")
+		} else if raw != published {
+			if err := d.publishGPUFitScores(ctx, raw); err != nil {
+				logger.Error(err, "Publishing GPUFit scores")
+			} else {
+				published = raw
+				logger.Info("Published GPUFit scores", "bytes", len(raw))
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
+
+// readGPUFitScores returns the raw scores JSON, or "" if the ConfigMap or key
+// doesn't exist.
+func (d *driver) readGPUFitScores(ctx context.Context, namespace, configMap string) (string, error) {
+	cm, err := d.client.CoreV1().ConfigMaps(namespace).Get(ctx, configMap, metav1.GetOptions{})
+	if apierrors.IsNotFound(err) {
+		return "", nil
+	}
+	if err != nil {
+		return "", err
+	}
+	return cm.Data[gpufitScoresKey], nil
+}
+
+func (d *driver) publishGPUFitScores(ctx context.Context, raw string) error {
+	resources := d.state.driverResources
+	if raw != "" {
+		scores, err := parseGPUFitScores(raw)
+		if err != nil {
+			return err
+		}
+		resources = withGPUFitScores(resources, scores)
+	}
+	return d.helper.PublishResources(ctx, resources)
+}
